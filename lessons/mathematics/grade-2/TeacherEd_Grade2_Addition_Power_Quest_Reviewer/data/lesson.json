  "grade": "Grade 2",
  "subject": "Mathematics",
  "title": "Addition Power Quest",
  "subtitle": "Adding Without Regrouping \u2022 Adding With Regrouping \u2022 Properties of Addition",
  "objectives": [
    "Add 2- and 3-digit numbers without regrouping.",
    "Add 2- and 3-digit numbers with regrouping using place-value reasoning.",
    "Identify and use the commutative, associative, and identity properties of addition.",
    "Choose an efficient strategy and explain why it works."
  ],
  "vocabulary": [
    [
      "addend",
      "a number being added"
    ],
    [
      "sum",
      "the answer in an addition sentence"
    ],
    [
      "regroup",
      "trade 10 ones for 1 ten, or 10 tens for 1 hundred"
    ],
    [
      "commutative",
      "changing the order of addends does not change the sum"
    ],
    [
      "associative",
      "changing the grouping of addends does not change the sum"
    ],
    [
      "identity",
      "adding zero keeps the number the same"
    ]
  ],
  "properties": [
    {
      "name": "Commutative Property",
      "cue": "CHANGE PLACES",
      "rule": "Changing the order of the addends does not change the sum.",
      "example": "4 + 8 = 8 + 4"
    },
    {
      "name": "Associative Property",
      "cue": "CHANGE GROUPS",
      "rule": "Changing the grouping of the addends does not change the sum.",
      "example": "(5 + 7) + 3 = 5 + (7 + 3)"
    },
    {
      "name": "Identity Property",
      "cue": "ZERO CHANGES NOTHING",
      "rule": "When zero is added to a number, the sum is the number itself.",
      "example": "3 + 0 = 3"
    }
  ],
